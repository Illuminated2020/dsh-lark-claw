# Legacy environment fallback for dsh-lark-claw.
# Recommended configuration: $DSH_HOME/config.yaml (normally ~/.dsh/config.yaml).
FEISHU_WORKSPACE=/srv/dsh/workspace
FEISHU_CHANNELS='[{"id":"main","appId":"cli_xxx","appSecretEnv":"FEISHU_MAIN_APP_SECRET","dmMode":"allowlist","dmAllowlist":["ou_xxx"],"groupAllowlist":["oc_xxx"]}]'
FEISHU_MAIN_APP_SECRET=replace-me

# Set these before starting dsh.
FEISHU_PROVIDER=your-provider
FEISHU_MODEL=your-model
DEEPSEEK_API_KEY=replace-me
